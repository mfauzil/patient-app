<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-patient-table" author="fauzil">

        <createTable tableName="patient">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_patient" nullable="false"/>
            </column>
            <column name="pid" type="VARCHAR(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_patient_pid"/>
            </column>
            <column name="first_name" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_birth" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_no" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="address_line" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="suburb" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="postcode" type="VARCHAR(4)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="patient" indexName="ix_patient_last_name">
            <column name="last_name"/>
        </createIndex>

        <createIndex tableName="patient" indexName="ix_patient_first_name">
            <column name="first_name"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>