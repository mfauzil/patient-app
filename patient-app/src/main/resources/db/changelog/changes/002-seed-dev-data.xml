<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-seed-dev-data" author="fauzil" context="dev">
        <loadData tableName="patient" file="db/changelog/data/patients.csv" separator=",">
            <column name="pid"           type="STRING"/>
            <column name="first_name"    type="STRING"/>
            <column name="last_name"     type="STRING"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="gender"        type="STRING"/>
            <column name="phone_no"      type="STRING"/>
            <column name="address_line"  type="STRING"/>
            <column name="suburb"        type="STRING"/>
            <column name="state"         type="STRING"/>
            <column name="postcode"      type="STRING"/>
        </loadData>
    </changeSet>
</databaseChangeLog>